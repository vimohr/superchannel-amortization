def OpenQ.Problems.AmortizationCollapseSuperchannelDivergences_148275.geometricStateDivergence : ℝ → StateDivergence :=
fun α x x_1 x_2 ρ σ ↦ if RangeIncluded ρ σ then ↑(log₂ (geometricMoment α ρ σ) / (α - 1)) else ⊤
def OpenQ.Problems.AmortizationCollapseSuperchannelDivergences_148275.amortizedChannelDivergence : StateDivergence →
  {a b : ℕ} → Channel a b → Channel a b → EReal :=
fun D {a b} N M ↦
  sSup
    {v |
      ∃ r,
        ∃ (_ : 0 < r),
          ∃ ρ σ,
            OpenQ.IsDensityMatrix ρ ∧
              OpenQ.IsDensityMatrix σ ∧
                ∃ t,
                  D (Fin r × Fin a) ρ σ = ↑t ∧
                    v =
                      D (Fin r × Fin b) ((OpenQ.Problems.EqualWeightLowChoiRank_523ed7.amplification r ↑N) ρ)
                          ((OpenQ.Problems.EqualWeightLowChoiRank_523ed7.amplification r ↑M) σ) -
                        ↑t}
