  [Fintype n] → [DecidableEq n] → Operator n → ℝ → Operator n :=
fun {n} [Fintype n] [DecidableEq n] X α ↦ hermitianSpectralFunction (fun x ↦ x.rpow α) X
def OpenQ.Problems.AmortizationCollapseSuperchannelDivergences_148275.geometricMoment : {n : Type} →
  [Fintype n] → [DecidableEq n] → ℝ → Operator n → Operator n → ℝ :=
fun {n} [Fintype n] [DecidableEq n] α ρ σ ↦ (σ * hermitianPower (supportInvSqrt σ * ρ * supportInvSqrt σ) α).trace.re
def OpenQ.Problems.AmortizationCollapseSuperchannelDivergences_148275.geometricStateDivergence : ℝ → StateDivergence :=
fun α x x_1 x_2 ρ σ ↦ if RangeIncluded ρ σ then ↑(log₂ (geometricMoment α ρ σ) / (α - 1)) else ⊤
