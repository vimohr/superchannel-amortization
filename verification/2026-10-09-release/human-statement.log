def OpenQ.Problems.AmortizationCollapseSuperchannelDivergences_148275.RangeIncluded : {n : Type} →
  [Fintype n] → Operator n → Operator n → Prop :=
fun {n} [Fintype n] ρ σ ↦ (Set.range fun v ↦ Matrix.mulVec ρ v) ⊆ Set.range fun v ↦ Matrix.mulVec σ v
def OpenQ.Problems.AmortizationCollapseSuperchannelDivergences_148275.supportInvSqrtScalar : ℝ → ℝ :=
fun x ↦ if x = 0 then 0 else (√x)⁻¹
