fun {a b} Φ ↦
  OpenQ.Problems.EqualWeightLowChoiRank_523ed7.IsCompletelyPositive Φ ∧
    ∀ (X : Matrix (Fin a) (Fin a) ℂ), (Φ X).trace = X.trace
def OpenQ.Problems.EqualWeightLowChoiRank_523ed7.IsCompletelyPositive : {a b : ℕ} →
  (Matrix (Fin a) (Fin a) ℂ →ₗ[ℂ] Matrix (Fin b) (Fin b) ℂ) → Prop :=
fun {a b} Φ ↦
  ∀ (k : ℕ),
    0 < k →
      ∀ (X : Matrix (Fin k × Fin a) (Fin k × Fin a) ℂ),
        X.PosSemidef → ((OpenQ.Problems.EqualWeightLowChoiRank_523ed7.amplification k Φ) X).PosSemidef
