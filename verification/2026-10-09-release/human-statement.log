def OpenQ.Problems.AmortizationCollapseSuperchannelDivergences_148275.ReferenceStabilizedMainStatement : Prop :=
∀ (a b c d : ℕ),
  0 < a →
    0 < b →
      0 < c →
        0 < d →
          ∀ (α : ℝ),
            1 < α →
              α ≤ 2 →
                ∀ (Θ₁ Θ₂ : PhysicalSuperchannel a b c d),
                  referenceStabilizedAmortizedDivergence (geometricStateDivergence α) Θ₁ Θ₂ =
                    referenceStabilizedOrdinaryDivergence (geometricStateDivergence α) Θ₁ Θ₂
def OpenQ.Problems.AmortizationCollapseSuperchannelDivergences_148275.referenceStabilizedOrdinaryDivergence : StateDivergence →
  {a b c d : ℕ} → PhysicalSuperchannel a b c d → PhysicalSuperchannel a b c d → EReal :=
fun D {a b c d} Θ₁ Θ₂ ↦
  sSup
    {v |
      ∃ r,
        ∃ (_ : 0 < r),
          ∃ N ρ, OpenQ.IsDensityMatrix ρ ∧ v = D (Fin (d * r)) ((Θ₁.referenceAct r ↑N) ρ) ((Θ₂.referenceAct r ↑N) ρ)}
def OpenQ.Problems.AmortizationCollapseSuperchannelDivergences_148275.referenceStabilizedAmortizedDivergence : StateDivergence →
  {a b c d : ℕ} → PhysicalSuperchannel a b c d → PhysicalSuperchannel a b c d → EReal :=
fun D {a b c d} Θ₁ Θ₂ ↦
  sSup
    {v |
      ∃ r,
        ∃ (_ : 0 < r),
          ∃ N M t,
            amortizedChannelDivergence D N M = ↑t ∧
              v = amortizedChannelDivergence D (Θ₁.referenceOnChannel r N) (Θ₂.referenceOnChannel r M) - ↑t}
def OpenQ.Problems.AmortizationCollapseSuperchannelDivergences_148275.amortizedChannelDivergence : StateDivergence →
  {a b : ℕ} → Channel a b → Channel a b → EReal :=
fun D {a b} N M ↦
  sSup
    {v |
      ∃ r,
        ∃ (_ : 0 < r),
          ∃ ρ σ,
            OpenQ.IsDensityMatrix ρ ∧
              OpenQ.IsDensityMatrix σ ∧
                ∃ t,
                  D (Fin r × Fin a) ρ σ = ↑t ∧
                    v =
                      D (Fin r × Fin b) ((OpenQ.Problems.EqualWeightLowChoiRank_523ed7.amplification r ↑N) ρ)
                          ((OpenQ.Problems.EqualWeightLowChoiRank_523ed7.amplification r ↑M) σ) -
                        ↑t}
